# MQTT Configuration (Home Assistant Mosquitto Broker)
# If using official HA Mosquitto add-on, default is core-mosquitto
MQTT_HOST=core-mosquitto
MQTT_PORT=1883
MQTT_USER=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password
MQTT_TOPIC_PREFIX=zigma/aerio-300
HA_DISCOVERY_PREFIX=homeassistant

# Zigma Purifier Configuration
# THING_NAME: Optional device ID (e.g. aerio-300-xx-xx-xx-xx-xx-xx).
# If left empty, the bridge automatically queries your Zigma account and discovers your device!
THING_NAME=
SUB_TYPE=aerio-300
REGION=ap-southeast-1
SYNC_INTERVAL=15

# Zigma Cloud Authentication (Dual Mode: Static JWT Token and/or Username/Password)
# If JWT_TOKEN is valid, it is used directly. If empty or expired, the bridge
# automatically logs in using ZIGMA_ACCOUNT and ZIGMA_PASSWORD to obtain a fresh token.
ZIGMA_ACCOUNT=your_email_or_phone
ZIGMA_PASSWORD=your_password
ZIGMA_CALLING_CODE=001
JWT_TOKEN=

# Cloud Endpoints (defaults)
OAUTH_URL=https://zigma.grit-cloud.com/prod/oauth
WSS_URL=wss://zigma.grit-cloud.com/prod/wss
